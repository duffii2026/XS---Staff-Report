{
  "name": "apa-staff-report-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:dist": "node dist/index.mjs",
    "dev": "cross-env ENV_FILE=.env2.local node index.js",
    "serve": "pm2 start ecosystem.config.cjs --only apa2-staff-report-api",
    "build": "webpack --config webpack.config.mjs --mode production",
    "seed": "node scripts/seed.js",
    "migrate:passwords": "node scripts/encrypt-passwords.js",
    "check": "node --check index.js && node --check services/auth.js && node --check services/passwordCrypto.js && node --check scripts/encrypt-passwords.js"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/credential-provider-ini": "^3.973.16",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@google/genai": "^2.4.0",
    "@smithy/node-http-handler": "^4.12.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "nanoid": "^5.0.7"
  }
}
