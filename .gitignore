# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist2/
dist3/
dist1/
dist*/
build/
.next/
out/
.vite/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime
*.pid
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Uploads / generated files
uploads/
storage/

# Certificates / private keys
*.pem
*.key
*.crt

# AWS credentials (never commit keys; instances point at them via AWS_SHARED_CREDENTIALS_FILE)
**/.aws/credentials
**/.aws/credentials_*

# Database local files
*.sqlite
*.sqlite3
*.db

/backend/.env
backend/.env

# Local environment files and secrets are never committed.
**/.env*
!**/.env.example
!**/.env.*.example
